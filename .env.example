# Use an address the sync container can reach. localhost means the sync container.
AUDIOBOOKSHELF_URL=https://audiobookshelf.example.com
# Credential for the ABS user whose listening history you want.
AUDIOBOOKSHELF_TOKEN=
# Personal access token from https://readwise.io/access_token
READWISE_TOKEN=

TIMEZONE=UTC
POLL_MINUTES=15
SETTLE_MINUTES=45

# Empty imports all available history. To limit it, use an ISO timestamp:
# IMPORT_SINCE=2026-10-01T00:00:00Z
IMPORT_SINCE=
# Feed posting is off. Optional: publish sessions started after this timestamp
# only if imported within 48 hours. Older history always stays off the feed.
PUBLISH_FROM=

# Optional app automation. Leave empty for the official API only.
# Run: docker compose run --rm sync --login
# Approve on your signed-in Readwise Books phone, then set:
# READWISE_APP_SESSION_FILE=/data/readwise-session
READWISE_APP_SESSION_FILE=

# Optional UID/GID for ownership of the bind-mounted data directory.
PUID=1000
PGID=1000
